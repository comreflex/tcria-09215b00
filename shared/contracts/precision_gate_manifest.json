{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Precision Gate Manifest v1.0",
  "description": "Schema for the unified Precision Gate custody report.",
  "version": "1.0",
  "type": "object",
  "required": ["schema_version", "case_id", "execution_id", "final_status", "confidence", "human_review_required"],
  "properties": {
    "schema_version": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "case_id": {"type": "string"},
    "execution_id": {"type": "string"},
    "final_status": {
      "type": "string",
      "enum": ["approved", "conditional", "returned_for_correction", "blocked", "human_review_required", "pending", "in_review"]
    },
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "human_review_required": {"type": "boolean"},
    "non_abandonment_flags": {"type": "array", "items": {"type": "string"}},
    "custody_hashes": {
      "type": "object",
      "properties": {
        "tcria_bundle_sha256": {"type": ["string", "null"]},
        "quinta_ordem_decision_sha256": {"type": ["string", "null"]}
      }
    },
    "confidence_breakdown": {"type": "object"},
    "remaining_uncertainties": {"type": "array"},
    "timestamps": {"type": "object"},
    "audit_trail": {"type": "object"}
  }
}
