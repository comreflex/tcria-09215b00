{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Quinta Ordem ExecutionContext v1.0",
  "description": "Input schema for QuintaOrdemGate.evaluate(). Produced by TCRIAExecutionContextAdapter.",
  "version": "1.0",
  "type": "object",
  "required": ["quinta_ordem_adapter_version", "execution_id", "evidence", "artifacts", "gate_results", "logs", "decisions", "metadata"],
  "properties": {
    "quinta_ordem_adapter_version": {"type": "string", "const": "1.0"},
    "execution_id": {"type": "string", "minLength": 1},
    "evidence": {"type": "array"},
    "artifacts": {"type": "array"},
    "gate_results": {"type": "array"},
    "logs": {"type": "array"},
    "decisions": {"type": "array"},
    "metadata": {
      "type": "object",
      "properties": {
        "open_points": {"type": "array"},
        "evidence_roots": {"type": "array"}
      }
    }
  }
}
